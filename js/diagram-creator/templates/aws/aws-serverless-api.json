{
  "id": "aws-serverless-api",
  "platformId": "aws",
  "name": "Serverless API",
  "description": "Event-driven serverless API using API Gateway, Lambda functions, DynamoDB, and SQS for asynchronous processing with Cognito authentication.",
  "thumbnailUrl": "images/diagram-templates/aws-serverless-api-thumb.png",
  "definition": {
    "components": [
      {
        "id": "cognito-1",
        "serviceId": "cognito",
        "position": { "x": 100, "y": 80 }
      },
      {
        "id": "api-gw-1",
        "serviceId": "api-gateway",
        "position": { "x": 300, "y": 80 }
      },
      {
        "id": "lambda-auth",
        "serviceId": "lambda",
        "position": { "x": 300, "y": 250 },
        "parentContainerId": "vpc-1"
      },
      {
        "id": "lambda-api",
        "serviceId": "lambda",
        "position": { "x": 500, "y": 250 },
        "parentContainerId": "vpc-1"
      },
      {
        "id": "lambda-worker",
        "serviceId": "lambda",
        "position": { "x": 700, "y": 250 },
        "parentContainerId": "vpc-1"
      },
      {
        "id": "dynamodb-1",
        "serviceId": "dynamodb",
        "position": { "x": 500, "y": 450 }
      },
      {
        "id": "sqs-1",
        "serviceId": "sqs",
        "position": { "x": 700, "y": 450 }
      },
      {
        "id": "s3-1",
        "serviceId": "s3",
        "position": { "x": 900, "y": 250 }
      },
      {
        "id": "eventbridge-1",
        "serviceId": "eventbridge",
        "position": { "x": 900, "y": 450 }
      }
    ],
    "containers": [
      {
        "id": "vpc-1",
        "type": "vpc",
        "label": "VPC",
        "children": ["lambda-auth", "lambda-api", "lambda-worker"]
      }
    ],
    "connectors": [
      {
        "id": "conn-cognito-apigw",
        "sourceId": "cognito-1",
        "targetId": "api-gw-1",
        "label": "Auth token",
        "directed": true
      },
      {
        "id": "conn-apigw-lambda-auth",
        "sourceId": "api-gw-1",
        "targetId": "lambda-auth",
        "label": "Authorizer",
        "directed": true
      },
      {
        "id": "conn-apigw-lambda-api",
        "sourceId": "api-gw-1",
        "targetId": "lambda-api",
        "label": "REST request",
        "directed": true
      },
      {
        "id": "conn-lambda-api-dynamodb",
        "sourceId": "lambda-api",
        "targetId": "dynamodb-1",
        "label": "Read/Write",
        "directed": true
      },
      {
        "id": "conn-lambda-api-sqs",
        "sourceId": "lambda-api",
        "targetId": "sqs-1",
        "label": "Async task",
        "directed": true
      },
      {
        "id": "conn-sqs-lambda-worker",
        "sourceId": "sqs-1",
        "targetId": "lambda-worker",
        "label": "Trigger",
        "directed": true
      },
      {
        "id": "conn-lambda-worker-s3",
        "sourceId": "lambda-worker",
        "targetId": "s3-1",
        "label": "Store result",
        "directed": true
      },
      {
        "id": "conn-lambda-worker-eventbridge",
        "sourceId": "lambda-worker",
        "targetId": "eventbridge-1",
        "label": "Emit event",
        "directed": true
      }
    ]
  }
}
